# Database Configuration (PostgreSQL)
# Dev local (stack Docker crosswords-api) :
DATABASE_URL=postgresql+psycopg://crossword:password@localhost:5432/crossword_db
# Prod VPS (via le réseau Docker prod_internal) :
# DATABASE_URL=postgresql+psycopg://crossword:CHANGEME@prod_postgres:5432/crossword_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=600

# API Configuration
API_TITLE=Crosswords Analytics API
API_VERSION=0.1.0
API_DESCRIPTION=Statistics and analytics service for crosswords application
DEBUG=false

# CORS Origins (comma-separated)
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:5173,https://crosswords-analytics-front.vercel.app
